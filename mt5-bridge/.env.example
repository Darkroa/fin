# Never commit the real values. Generate both secrets with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MT5_BRIDGE_KEY=replace-with-a-long-random-client-key
MT5_BRIDGE_SIGNING_SECRET=replace-with-a-different-long-random-hmac-secret

# Safety defaults
ALLOW_LIVE_ORDERS=false
MT5_MAX_DEVIATION=20
MT5_MAGIC_NUMBER=260818
MT5_NONCE_TTL_SECONDS=90
MT5_BRIDGE_DOCS=false

# The backend encrypts broker passwords before storing them and sends them only
# over the signed bridge request. This bridge does not persist broker passwords.