modules = ["nodejs-20", "python-3.12", "bash", "web"]
[Darkroa]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["cargo", "ffmpeg-full", "freetype", "glibcLocales", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "rustc", "tcl", "tk", "typescript", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo Mobile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start"

[[workflows.workflow]]
name = "Expo Mobile"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash expo.sh"
waitForPort = 8099

[[workflows.workflow]]
name = "Start"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8099
externalPort = 80

[userenv]

[userenv.shared]
API_BASE_URL = "http://localhost:8000/api"
REDIS_URL = "redis://localhost:6379/0"
REDIS_RESULT_BACKEND = "redis://localhost:6379/1"
SLACK_CHANNEL = "#trading-alerts"
CELERY_TASK_ALWAYS_EAGER = "false"
EVOLUTION_API_URL = "http://localhost:8080"
EVOLUTION_INSTANCE = "FinAiEvobots"
PROMETHEUS_URL = "http://localhost:9090"
GRAFANA_URL = "http://localhost:3001"

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "cd /home/runner/workspace && PYTHONPATH=/home/runner/workspace PATH=/home/runner/workspace/.pythonlibs/bin:$PATH python3 -m uvicorn src.api.main:app --host 0.0.0.0 --port 5000"]
build = ["sh", "-c", "cd /home/runner/workspace/frontend && npm install --legacy-peer-deps && npm run build"]

[darkroa]
expertMode = true

[agent]
expertMode = true
